<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="settings.xsd">

    <!-- Paths are relative to the project root (the folder sdmc runs in). -->

    <!-- target: the folder of the generated headers, models and DAO (<Class>.h), next to
            DataStore.h and DataStore.cpp
         sql: base folder of SQL files -->

    <folders target="." sql="sdm/sql"/>

    <!-- field-names-mode: the fields of models and the names of CRUD methods
            0 - as is: the column names (create + Task: createTask)
            1 - lowerCamelCase (taskId, createTask)
            2 - snake_case (task_id, create_task)
         scope, field-assign-mode: the IDE plug-in only; sdmc ignores them for C++. -->

    <dto scope="" inheritance="" field-names-mode="0" macro=""/>

    <dao scope="" field-assign-mode="0" macro=""/>

    <ide event-log="true"/>

    <!-- One "settings.xml" for the IDE plug-in and for sdmc:
            jdbc  - the IDE plug-in (jar, class and url of JDBC); sdmc does not read it.
            db    - sdmc (url: postgres://host:port/db, mysql://host:port/db or sqlite:<file>);
                    the IDE plug-in ignores it. SDM_PWD, if set, overrides "pwd" of db. -->

    <jdbc jar="sdm/sqlite-jdbc-3.53.2.1.jar" class="org.sqlite.JDBC"
          url="jdbc:sqlite:$PROJECT_DIR$/thesaurus.sqlite" user="" pwd=""/>

    <db url="sqlite:thesaurus.sqlite" user="" pwd=""/>

    <!-- detected: the type of a column as the driver names it. The keys below are SQLite
         (sdmc init -db pg, mysql or sqlite). PostgreSQL says int4, varchar, timestamptz, ...;
         MySQL says INT, VARCHAR, DATETIME, UNSIGNED BIGINT, ...;
         SQLite says what the column is declared with: INTEGER, VARCHAR, ...

         target: a value class of DataStore.h (Qt, the driver QSQLITE): CInteger (qint64),
         CDouble, CText (QString), CBlob (QByteArray) for NOT NULL columns, CIntegerN, CDoubleN,
         CTextN, CBlobN (Value and IsNull) for nullable ones; CVariant holds anything in a QVariant.
         "CText${N}" is CTextN for a nullable column of a table and CText otherwise (the macro ${N}
         below). Add your own classes to DataStore.h and use them here.

         To see which names your database gives, empty the type-map: <type-map default=""/>
         and generate. The code then has the raw names of the driver instead of C++ classes.
         unknown - the driver said nothing about the type (MySQL parameters, SQLite expressions). -->

    <type-map default="">

        <type detected="INTEGER" target="CInteger${N}"/>
        <type detected="INT" target="CInteger${N}"/>
        <type detected="BIGINT" target="CInteger${N}"/>
        <type detected="SMALLINT" target="CInteger${N}"/>
        <type detected="TINYINT" target="CInteger${N}"/>
        <type detected="MEDIUMINT" target="CInteger${N}"/>
        <type detected="UNSIGNED BIG INT" target="CInteger${N}"/>
        <type detected="INT2" target="CInteger${N}"/>
        <type detected="INT8" target="CInteger${N}"/>
        <type detected="STRING" target="CText${N}"/>
        <type detected="VARYING CHARACTER" target="CText${N}"/>
        <type detected="NATIVE CHARACTER" target="CText${N}"/>
        <type detected="REAL" target="CDouble${N}"/>
        <type detected="DOUBLE" target="CDouble${N}"/>
        <type detected="FLOAT" target="CDouble${N}"/>
        <type detected="NUMERIC" target="CDouble${N}"/>
        <type detected="DECIMAL" target="CDouble${N}"/>
        <type detected="TEXT" target="CText${N}"/>
        <type detected="VARCHAR" target="CText${N}"/>
        <type detected="CHAR" target="CText${N}"/>
        <type detected="CHARACTER" target="CText${N}"/>
        <type detected="NVARCHAR" target="CText${N}"/>
        <type detected="NCHAR" target="CText${N}"/>
        <type detected="CLOB" target="CText${N}"/>
        <type detected="BLOB" target="CBlob${N}"/>
        <type detected="DOUBLE PRECISION" target="CDouble${N}"/>
        <type detected="MONEY" target="CDouble${N}"/>
        <type detected="NTEXT" target="CText${N}"/>
        <type detected="BINARY" target="CBlob${N}"/>
        <type detected="VARBINARY" target="CBlob${N}"/>
        <type detected="IMAGE" target="CBlob${N}"/>
        <type detected="BIT" target="CInteger${N}"/>

        <type detected="BOOLEAN" target="CInteger${N}"/>
        <type detected="DATE" target="CText${N}"/>
        <type detected="DATETIME" target="CText${N}"/>
        <type detected="TIMESTAMP" target="CText${N}"/>
        <type detected="unknown" target="CVariant"/>

        <!-- The Java names: the explicit types of <field type="..."/> in sdm.xml (SQLite says
             nothing about the columns of a query before it runs) and the keys of the IDE plug-in. -->

        <type detected="java.lang.Integer" target="CInteger${N}"/>
        <type detected="java.lang.Long" target="CInteger${N}"/>
        <type detected="java.lang.Double" target="CDouble${N}"/>
        <type detected="java.lang.String" target="CText${N}"/>
        <type detected="byte[]" target="CBlob${N}"/>
        <type detected="java.lang.Object" target="CVariant"/>

    </type-map>

    <macros>

        <!-- ${N}: "N" for a nullable column of a table (CTextN), nothing for NOT NULL and PK (CText);
             SQLite reports "integer primary key" as nullable -->
        <macro name="${N}">
            <vm-xml>
                <if var="$fi.Nullable &amp;&amp; !$fi.PK">
                    <print var="N"/>
                </if>
            </vm-xml>
        </macro>

    </macros>

</settings>
