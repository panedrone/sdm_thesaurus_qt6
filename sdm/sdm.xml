<?xml version="1.0" encoding="UTF-8"?>
<sdm xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="sdm.xsd">

    <dto-class name="Word" ref="WORDS"/>

    <!-- SQLite says nothing about the columns of a query before it runs: their types are here -->
    <dto-class name="RelatedWord" ref="getRelatedWords.sql">
        <field type="CText" column="RG_PART_OF_SPEECH"/>
        <field type="CInteger" column="RG_ORDER"/>
        <field type="CInteger" column="RGW_ID"/>
        <field type="CInteger" column="RG_ID"/>
        <field type="CText" column="RGW_WORD"/>
        <field type="CText" column="RGW_NOTE"/>
        <field type="CInteger" column="RGW_ORDER"/>
    </dto-class>

    <dao-class name="ThesaurusDao">

        <query ref="getTotalWordsCount.sql" method="getTotalWordsCount" return-type="CInteger"/>

        <query-dto-list ref="getWordsByKey.sql" dto="Word" method="getWordsByKey(key)"/>

        <query-dto-list ref="getRelatedWords.sql" dto="RelatedWord" method="getRelatedWords(CInteger w_id)"/>

    </dao-class>

</sdm>
