{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug sdm_demo_qt6_thesaurus",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "cwd": "${workspaceFolder}",
            "environment": [
                { "name": "PATH", "value": "C:/Qt/6.8.3/mingw_64/bin;C:/mingw64/bin;${env:PATH}" }
            ],
            "MIMode": "gdb",
            "miDebuggerPath": "C:/mingw64/bin/gdb.exe",
            "externalConsole": false,
            "setupCommands": [
                { "description": "Pretty printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ],
            "preLaunchTask": "CMake: build"
        }
    ]
}
